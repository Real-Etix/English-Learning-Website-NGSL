DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ngsl_mood_trainer"

# LLM enrichment (Kimi / Moonshot AI, OpenAI-compatible)
# Get a key at https://platform.moonshot.ai
LLM_API_KEY=""
# Exact model id from your Moonshot account (e.g. kimi-k2.5 / kimi-k2.6 / kimi-k3)
LLM_MODEL="kimi-k2.5"
# Override only if not using Moonshot's default endpoint
# LLM_BASE_URL="https://api.moonshot.ai/v1"

# Website tutor/grader: OFF until the additive runtime budget tables are installed.
# Offline enrichment does not use these settings. See docs/runtime-ai-budget.md.
AI_RUNTIME_ENABLED="false"
AI_RUNTIME_DAILY_MICRO_CNY="1000000"
AI_RUNTIME_HMAC_SECRET=""
AI_RUNTIME_PRICE_POLICY="deepseek-flash-2026-10-26"
# When enabling runtime AI, use the intended DeepSeek key with:
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL="deepseek-v4-flash"
# Price policy expires 2026-11-25T00:00:00Z; review/renew in code, not by overriding the date.

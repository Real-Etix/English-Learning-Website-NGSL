{
  "name": "ngsl-mood-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:vocabulary": "tsx scripts/lint-vocabulary.ts",
    "test": "vitest run",
    "audit:dictionary": "tsx scripts/audit-dictionary.ts",
    "test:e2e": "playwright test tests/e2e/galaxy-progressive.spec.ts",
    "test:perf": "playwright test tests/e2e/galaxy-performance.spec.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed:spaces": "tsx scripts/seed-spaces.ts",
    "build:vocabulary": "tsx scripts/build-word-data.ts",
    "build:graphs": "tsx scripts/build-word-data.ts && tsx scripts/build-graph-data.ts && tsx scripts/build-galaxy-assets.ts",
    "quarantine:advanced": "tsx scripts/quarantine-advanced-drafts.ts",
    "verify:advanced": "tsx scripts/verify-advanced-vocabulary.ts",
    "enrich:vocabulary": "tsx scripts/enrich-vocabulary.ts",
    "migrate:vocabulary": "echo 'RECOVERY-ONLY: migrate legacy Markdown into a separate NDJSON output for review.' && npm run migrate:vocabulary:recovery",
    "migrate:vocabulary:recovery": "tsx scripts/migrate-wiki-to-ndjson.ts",
    "validate:vocabulary-migration": "tsx scripts/validate-vocabulary-migration.ts",
    "schema:vocabulary": "tsx scripts/generate-vocabulary-schema.ts",
    "import:lists": "tsx scripts/import-ngsl.ts",
    "generate:enrichments": "tsx scripts/generate-enrichments.ts",
    "refresh:content": "npm run import:lists && npm run generate:enrichments"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "next": "16.2.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "wordpos": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
